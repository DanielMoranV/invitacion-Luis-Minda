# ─────────────────────────────────────────────────────────────────────────
#  Invitación Luis & Minda — variables de entorno
#
#  Copia este archivo a `.env` y reemplaza los valores marcados con <>.
#  `.env` está en .gitignore: nunca se sube al repositorio.
#
#  Dónde sacar cada valor está indicado en cada bloque.
#  Guía paso a paso: docs/firebase-setup.md
# ─────────────────────────────────────────────────────────────────────────


# ── 1. Firebase (obligatorio) ────────────────────────────────────────────
#
# Consola de Firebase > ⚙ Configuración del proyecto > pestaña General.
#
#   PROJECT_ID  ->  "ID del proyecto"
#   API_KEY     ->  baja a "Tus apps", elige la app web y copia `apiKey`
#                   del bloque firebaseConfig. Si no hay app web todavía,
#                   pulsa "Añadir app" > icono Web (</>).
#
# Estos dos valores quedan incrustados en el JavaScript del sitio, y está
# bien: en Firebase la seguridad la dan las reglas de firestore.rules, no
# ocultar la clave. No son secretos.
#
# ⚠ El PROJECT_ID también hay que ponerlo en `.firebaserc`, que es lo que
#   usa `firebase deploy`. Ese archivo no lee variables de entorno.

PUBLIC_FIREBASE_PROJECT_ID=<tu-project-id>
PUBLIC_FIREBASE_API_KEY=<tu-api-key>


# ── 2. Identificador de la boda ──────────────────────────────────────────
#
# Nombre del documento raíz en Firestore: bodas/<PUBLIC_BODA_ID>/invitados
# Puedes dejarlo como está. Existe para poder reutilizar el proyecto con
# otra pareja sin tocar código.

PUBLIC_BODA_ID=luis-minda


# ── 3. Dominio público (obligatorio antes de compartir) ──────────────────
#
# De aquí salen el canonical y la URL absoluta de og:image. Si esto no
# apunta al dominio real, LA VISTA PREVIA DE WHATSAPP NO SE VERÁ.
#
# Mientras no haya dominio propio, usa el que da Firebase Hosting:
#   https://<tu-project-id>.web.app

SITIO=https://luisyminda.com


# ── 4. Desarrollo local (comentar para trabajar contra Firestore real) ───
#
# Con estas dos puestas, todo apunta al emulador y no se toca ni un dato
# real. Levanta el emulador con:  npm run emulador
#
#   PUBLIC_FIRESTORE_EMULATOR  ->  lo usa el navegador
#   FIRESTORE_EMULATOR_HOST    ->  lo usa el script de importación

PUBLIC_FIRESTORE_EMULATOR=127.0.0.1:8080
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080


# ── 5. Cuenta de servicio (solo para importar a Firestore REAL) ──────────
#
# Únicamente si vas a ejecutar `npm run importar` contra la base real.
# Para el emulador NO hace falta, y el sitio publicado tampoco la usa.
#
# Consola > ⚙ Configuración del proyecto > Cuentas de servicio >
# "Generar nueva clave privada". Descarga el JSON y pégalo aquí ENTERO
# en una sola línea, entre comillas simples.
#
# ⚠ Esto SÍ es un secreto: da acceso total al proyecto. Nunca al repositorio.
#
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}'
