---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Solo las dos capas de fondo. La <section> que las contiene la escribe
// el componente que lo usa: si el <section> se generara aquí, el CSS con
// scope del consumidor no alcanzaría a ese elemento.
interface Props {
  src: ImageMetadata;
  alt: string;
  velo: string;
  posicion?: string;
  prioritaria?: boolean;
}

const { src, alt, velo, posicion = '50% 50%', prioritaria = false } = Astro.props;
---

<Image
  class="foto-fondo__img"
  src={src}
  alt={alt}
  widths={[430, 640, 860]}
  sizes="(max-width: 430px) 100vw, 430px"
  loading={prioritaria ? 'eager' : 'lazy'}
  fetchpriority={prioritaria ? 'high' : 'auto'}
  decoding={prioritaria ? 'sync' : 'async'}
  style={`object-position: ${posicion}`}
/>
<div class="foto-fondo__velo" style={`background-image: ${velo}`}></div>
