---
import { Image } from 'astro:assets';
import { fotos } from '../fotos';
import evento from '../content/evento.json';

interface Props {
  /** true en /i/<slug>; false en la portada genérica. */
  personalizada?: boolean;
}

const { personalizada = false } = Astro.props;
const { fecha, lugar } = evento;
---

<section class="rsvp" data-hora-ceremonia={lugar.horaCeremonia} data-fecha-completa={fecha.completa}>
  <div class="rsvp__cabecera" data-reveal>
    <h2 class="rsvp__titulo">Confirma tu asistencia</h2>
    <p class="rsvp__plazo">
      Te pedimos confirmar antes del <strong>{fecha.limiteConfirmacion}</strong>.
    </p>
    <p class="rsvp__invitado" data-invitado-etiqueta hidden></p>
  </div>

  {
    !personalizada ? (
      <div class="rsvp__aviso">
        <span class="rombo rsvp__aviso-rombo" aria-hidden="true"></span>
        <p class="rsvp__aviso-texto">
          Cada invitación tiene su propio enlace. Abre el que te enviamos por
          WhatsApp para confirmar tu asistencia.
        </p>
      </div>
    ) : (
      <>
        <div class="rsvp__cargando" data-rsvp-cargando>
          <span class="rsvp__barra"></span>
          <span class="rsvp__barra rsvp__barra--corta"></span>
          <span class="rsvp__barra"></span>
        </div>

        <div class="rsvp__aviso" data-rsvp-fallo hidden>
          <span class="rombo rsvp__aviso-rombo" aria-hidden="true"></span>
          <p class="rsvp__aviso-texto">
            No pudimos cargar tu invitación. Revisa tu conexión y vuelve a abrir
            el enlace.
          </p>
        </div>

        <div class="rsvp__hecho" data-rsvp-hecho hidden>
          <span class="rombo rsvp__hecho-rombo" aria-hidden="true"></span>
          <p class="rsvp__hecho-titulo" data-rsvp-hecho-titulo></p>
          <p class="rsvp__hecho-mensaje" data-rsvp-hecho-mensaje></p>
        </div>

        <form class="rsvp__form" data-rsvp-form hidden novalidate>
          <label class="rsvp__campo">
            <span class="rsvp__etiqueta">Invitación a nombre de</span>
            <input
              class="rsvp__input"
              type="text"
              name="nombre"
              readonly
              data-invitado-nombre
            />
          </label>

          <fieldset class="rsvp__grupo">
            <legend class="rsvp__etiqueta">¿Nos acompañas?</legend>
            <div class="rsvp__opciones">
              <button type="button" class="rsvp__opcion" data-asiste="si" aria-pressed="false">
                Sí, asistiré
              </button>
              <button type="button" class="rsvp__opcion" data-asiste="no" aria-pressed="false">
                No podré
              </button>
            </div>
          </fieldset>

          <div class="rsvp__detalle" data-rsvp-detalle hidden>
            <label class="rsvp__campo">
              <span class="rsvp__etiqueta">Personas que asistirán</span>
              <select class="rsvp__input" name="lugares" data-rsvp-lugares></select>
            </label>

            <label class="rsvp__campo" hidden>
              <span class="rsvp__etiqueta">Restricciones alimentarias</span>
              <textarea
                class="rsvp__input rsvp__textarea"
                name="dieta"
                rows="3"
                placeholder="Alergias, vegetariano, sin gluten…"></textarea>
            </label>
          </div>

          <div class="rsvp__envio">
            <button type="submit" class="rsvp__enviar" data-rsvp-enviar>Enviar confirmación</button>
            <p class="rsvp__error" data-rsvp-error hidden role="alert"></p>
          </div>
        </form>
      </>
    )
  }

  <figure class="rsvp__figura" data-reveal>
    <Image
      src={fotos.manosUnidasDetalle}
      alt="Las manos de Luis y Minda unidas junto al vestido"
      widths={[378, 756, 1134]}
      sizes="(max-width: 430px) calc(100vw - 68px), 362px"
      loading="lazy"
      class="rsvp__foto"
    />
  </figure>
</section>

{personalizada && <script is:inline src="/rsvp.js"></script>}

<style>
  .rsvp { padding: 60px 26px; background: var(--crema); }

  .rsvp__cabecera { text-align: center; }

  .rsvp__titulo {
    margin: 0 0 8px;
    font-family: var(--script);
    font-weight: 400;
    font-size: 36px;
    color: var(--verde-titulo);
  }

  .rsvp__plazo {
    margin: 0 auto 6px;
    max-width: 30ch;
    font-size: 16px;
    line-height: 1.6;
    color: var(--tinta-tenue);
  }
  .rsvp__plazo strong { font-weight: 500; color: var(--tinta); }

  .rsvp__invitado { margin: 0 0 26px; font-size: 15px; color: var(--tinta-suave); }

  /* Aviso del enlace genérico y del fallo de carga */
  .rsvp__aviso {
    margin-top: 26px;
    padding: 30px 22px;
    text-align: center;
    border: 1px solid var(--linea);
    background: var(--crema-panel);
  }
  .rsvp__aviso[hidden] { display: none; }
  .rsvp__aviso-rombo { margin: 0 auto 16px; width: 7px; height: 7px; }
  .rsvp__aviso-texto {
    margin: 0 auto;
    max-width: 32ch;
    font-size: 16px;
    line-height: 1.65;
    color: var(--tinta-media);
  }

  /* Esqueleto mientras Firestore responde */
  .rsvp__cargando { display: grid; gap: 14px; margin-top: 30px; }
  .rsvp__cargando[hidden] { display: none; }
  .rsvp__barra {
    height: 46px;
    border-radius: 2px;
    background: linear-gradient(90deg, rgba(27, 37, 64, .05), rgba(27, 37, 64, .10), rgba(27, 37, 64, .05));
    background-size: 200% 100%;
    animation: latido 1.4s ease-in-out infinite;
  }
  .rsvp__barra--corta { width: 55%; }
  @keyframes latido {
    0%, 100% { background-position: 0% 0; }
    50% { background-position: -200% 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rsvp__barra { animation: none; }
  }

  .rsvp__form { display: grid; gap: 18px; margin-top: 26px; }
  .rsvp__form[hidden] { display: none; }

  .rsvp__campo { display: grid; gap: 7px; }
  .rsvp__campo[hidden] { display: none; }

  .rsvp__etiqueta {
    font-size: 11px;
    letter-spacing: .24em;
    text-transform: uppercase;
    color: var(--tinta-suave);
    padding: 0;
  }

  .rsvp__input {
    padding: 14px;
    border: 1px solid var(--linea-campo);
    border-radius: 0;
    background: var(--campo);
    font-size: 16px;
    color: var(--tinta);
    outline: none;
    width: 100%;
  }
  .rsvp__input:focus { border-color: var(--oro-oscuro); }
  .rsvp__input[readonly] { background: var(--crema-panel); color: var(--tinta-suave); }
  .rsvp__input[readonly]:focus { border-color: var(--linea-campo); }
  .rsvp__textarea { line-height: 1.5; resize: vertical; }

  .rsvp__ayuda { font-size: 14px; color: var(--tinta-tenue); }
  .rsvp__ayuda[hidden] { display: none; }

  .rsvp__grupo { border: 0; margin: 0; padding: 0; display: grid; gap: 9px; }
  .rsvp__opciones { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

  .rsvp__opcion {
    padding: 15px 8px;
    border: 1px solid var(--linea-campo);
    background: var(--campo);
    color: var(--tinta-tenue);
    font-family: var(--display);
    font-size: 11px;
    letter-spacing: .2em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background .2s ease, border-color .2s ease, color .2s ease;
  }
  .rsvp__opcion--activa {
    border-color: var(--activo-borde);
    background: var(--activo-fondo);
    color: var(--activo-tinta);
  }

  .rsvp__detalle { display: grid; gap: 18px; }
  .rsvp__detalle[hidden] { display: none; }

  .rsvp__envio { display: grid; gap: 10px; }

  .rsvp__enviar {
    padding: 17px;
    border: none;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--oro-claro), var(--oro) 46%, var(--oro-oscuro));
    color: #ffffff;
    font-family: var(--display);
    font-size: 12px;
    letter-spacing: .24em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity .2s ease;
  }
  .rsvp__enviar--inactivo { opacity: .55; }

  .rsvp__error { margin: 0; text-align: center; font-size: 14px; color: var(--aviso); }
  .rsvp__error[hidden] { display: none; }

  .rsvp__hecho {
    margin-top: 26px;
    padding: 34px 22px;
    text-align: center;
    border: 1px solid rgba(35, 68, 143, .4);
    background: var(--crema-panel);
  }
  .rsvp__hecho[hidden] { display: none; }
  .rsvp__hecho-rombo { margin: 0 auto 16px; width: 7px; height: 7px; }
  .rsvp__hecho-titulo { margin: 0; font-family: var(--display); font-size: 19px; color: var(--tinta); }
  .rsvp__hecho-mensaje { margin: 10px 0 0; font-size: 15px; line-height: 1.6; color: var(--tinta-tenue); }

  .rsvp__figura { margin: 36px 0 0; padding: 0 8px; }
  .rsvp__foto { width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; object-position: 50% 40%; }
</style>
